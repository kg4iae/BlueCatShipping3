# GEMINI_API_KEY: Optional AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted web application URL.
APP_URL="MY_APP_URL"

# EASYPOST_API_KEY: EasyPost API key for real-time address validation and postage label creation.
EASYPOST_API_KEY="EZTK_TEST_KEY"
EASYPOST_TEST_API_KEY="EZTK_TEST_KEY"
EASYPOST_PROD_API_KEY="EZAK_PROD_KEY"

# APP_ENV: "dev" or "prod"
APP_ENV="dev"

# EASYPOST_MODE: "test" or "production"
EASYPOST_MODE="test"

# MSSQL Configuration: For connecting to external Microsoft SQL Server database.
MSSQL_SERVER="localhost"
MSSQL_DATABASE="ShippingDB"
MSSQL_USER="sa"
MSSQL_PASSWORD="YourPassword123"

# APP_PASSWORD: Protection password for web app login (default: shipstation123)
APP_PASSWORD="shipstation123"
