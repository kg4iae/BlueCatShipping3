# Linux MySQL Database Configuration (BlueCat Bobbins Shared Database)
MYSQL_HOST="mysql8002.site4now.net"
MYSQL_PORT="3306"
MYSQL_DATABASE="db_a7ef02_bluecatbobbins"
MYSQL_USER="a7ef02_bluecatbobbins"
