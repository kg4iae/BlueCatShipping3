# APP_ENV: "dev" (maps to `shippingdev`) or "prod" (maps to `Shipping`)
APP_ENV="prod"

# APP_PASSWORD: Protection password for web app login (default: shipstation123)
APP_PASSWORD="shipstation123"

# Note: EasyPost API keys (Test & Production) and EasyPost Mode are stored directly
# in your MySQL Database table `Configuration` and managed from Settings -> EasyPost.
# No .env variables required for EasyPost!
